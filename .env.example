# ==============================================================================
# VITAFIT AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Multimodal & LLM AI Service (Google Gemini or compatible)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Client Configuration (Optional for client-side cloud sync)
# If not provided, VitaFit AI seamlessly runs with robust local persistence & offline mock mode!
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vitafit-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vitafit-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vitafit-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# App URL (for production deployments on Vercel or Hostinger)
NEXT_PUBLIC_APP_URL=http://localhost:3000
